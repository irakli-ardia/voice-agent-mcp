# Every variable the project reads. Copy to .env and fill in values; never commit .env.
# Only src/config/config.ts reads process.env — add new variables there and here in the same change.
# Every non-secret variable is validated at startup for every command; an invalid value exits with
# code 78 and names the variable, never its value.

# Log verbosity: fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info

# Largest serialised tool result, in UTF-8 bytes of its JSON, that the executor returns to a model
# or MCP client (1..1048576, default: 16384). Bounds what leaves the executor, not handler memory.
MAX_TOOL_RESULT_BYTES=16384

# Directory for runtime data (notes under DATA_DIR/notes). Resolved to an absolute path against the
# working directory at startup (default: .data). Must be a local filesystem with hard links (NTFS,
# ext4, APFS); notes are not guaranteed to survive an OS crash or power loss.
DATA_DIR=.data

# Agent loop limits (validated at startup; an invalid value exits with code 78).
# Maximum model invocations per turn, including the one that returns the answer (1..32, default: 8).
MAX_AGENT_ITERATIONS=8
# Maximum model-requested tool calls per turn, checked per response before any call runs
# (1..128, default: 16).
MAX_TOOL_CALLS_PER_TURN=16
# Maximum user text length in UTF-16 code units (1..32000, default: 4000).
MAX_INPUT_TEXT_CHARS=4000
# Wall-clock deadline for one whole turn, in milliseconds (5000..600000, default: 120000).
AGENT_TURN_TIMEOUT_MS=120000

# OpenAI — used only by `ask`.
# Secret API key. Read only by `ask`; `--help` and `tools` work without it. Never commit a real key.
OPENAI_API_KEY=
# Model id (default: gpt-6-luna).
OPENAI_MODEL=gpt-6-luna
# Timeout of one HTTP attempt, in milliseconds (1000..600000, default: 60000).
OPENAI_TIMEOUT_MS=60000
# Retries of transient failures (connection, timeout, 408, 409, 429, 5xx) within one model call
# (0..5, default: 2). Waits are bounded; a server-requested wait over 10 s ends retrying.
OPENAI_MAX_RETRIES=2
# Output token limit for one model call, reasoning included (256..32768, default: 4096).
OPENAI_MAX_OUTPUT_TOKENS=4096
# Reasoning effort: none | low (default: none).
OPENAI_REASONING_EFFORT=none
