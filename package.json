{
  "name": "voice-agent-mcp",
  "version": "0.1.0",
  "description": "Voice-driven OpenAI tool-calling agent whose tools are defined once and also served over MCP.",
  "license": "MIT",
  "author": "Irakli Ardia",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "voice-agent": "dist/entrypoints/voice-agent.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "node scripts/git/conventions.mjs install-hooks",
    "dev": "tsx src/entrypoints/voice-agent.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/entrypoints/voice-agent.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check . && oxlint",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:architecture": "vitest run tests/architecture",
    "check:forbidden-types": "vitest run tests/architecture/forbidden-type-escapes.test.ts",
    "fallow": "fallow --quiet",
    "docs:check": "node scripts/checks/docs-check.mjs",
    "git:check-current-branch": "node scripts/git/conventions.mjs current",
    "check": "npm run docs:check && npm run lint && npm run typecheck && npm run fallow && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@oxlint/plugins": "1.87.0",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "fallow": "3.31.0",
    "oxlint": "1.87.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
